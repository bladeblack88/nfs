; Most Wanted Mobile - original arcade street racing prototype
config_version=5

[application]
config/name="Most Wanted Mobile"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Original mobile arcade street racing prototype"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.16, 0.2, 0.27, 1)
